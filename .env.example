# 若專案裡已有名為 `.env` 的資料夾（舊版密鑰目錄），請把本檔複製成 `.env.local`
# 否則請複製成 `.env`
PORT=3000
NODE_ENV=development

# 必填：JWT 簽名密鑰（正式環境請改成高熵隨機字串）
JWT_SECRET=replace_with_a_long_random_secret

# 必填：Gemini
GEMINI_API_KEY=

# 必填：Supabase（後端以 service role 作為 API 代理層，前端不直連）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 可選：若要在登入時走 GoTrue email/password（lazy 建立 auth.users）
# 未設定時仍可用 profiles.password_hash（bcrypt）驗證
SUPABASE_ANON_KEY=

# 檔案儲存：local | supabase | dual
# local    = 只寫 ./uploads/
# supabase = 只寫 Storage bucket clinical-docs
# dual     = 同時寫本地與 bucket（遷移期建議）
STORAGE_DRIVER=local
